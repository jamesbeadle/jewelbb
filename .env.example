# ============================================================
# Copy this file to .env for local development.
# On Vercel, set the same variables in Project → Settings →
# Environment Variables (then redeploy).
# ============================================================

# ---- Contact form email delivery (Resend — https://resend.com) ----
# Create a free account, verify the jewelbb.co.uk domain, create an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are sent
CONTACT_TO_EMAIL=sales@jewelbb.co.uk

# The "from" address. Until the domain is verified in Resend you can
# omit this and Resend's shared test sender is used.
CONTACT_FROM_EMAIL=website@jewelbb.co.uk

# ---- Admin area (/admin) ----
# Choose your own values; the site compares login attempts against these.
# Use a long, unique password — the login is rate-limited (5 failed
# attempts per IP in 15 minutes) but the password is still the main lock.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Secret for signing the login cookie: any long random string, e.g. the
# output of `openssl rand -base64 32`. Falls back to ADMIN_PASSWORD if
# unset, but set it — changing it also signs every admin out at once.
ADMIN_SESSION_SECRET=

# ---- Brochure PDF generation ----
# The PDF endpoints run headless Chromium. On Vercel this uses the bundled
# @sparticuz/chromium build automatically — nothing to configure. For local
# development the site looks for an installed Chrome/Chromium; set this only
# if yours lives somewhere unusual.
# PDF_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---- Supabase (staff + brochure content) ----
# Supabase dashboard → Project Settings → API:
#   - Project URL            → SUPABASE_URL
#   - service_role key       → SUPABASE_SERVICE_ROLE_KEY  (keep secret!)
# Then run supabase/schema.sql in the SQL Editor once.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
