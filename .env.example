# Contact form email delivery (Resend — https://resend.com)
# Create a free account, add + verify the jewelbb.co.uk domain, create an API key,
# then set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are sent
CONTACT_TO_EMAIL=sales@jewelbb.co.uk

# The "from" address. Until the domain is verified in Resend you can use
# onboarding@resend.dev (Resend's shared test sender).
CONTACT_FROM_EMAIL=website@jewelbb.co.uk
